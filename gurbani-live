function quick_play() {
    local last_played=$(load_last_played)
    if [ -z "$last_played" ]; then
        echo -e "${RED}No last played channel found. Please select a channel first.${NC}"
        exit 1
    fi

    echo -e "${CYAN}Quick playing last channel: ${GREEN}$last_played${NC}"

    execute_and_wait "curl -sf --connect-timeout 5 --max-time 15 https://play.sikhnet.com/api/radio -o ${RADIO_DATA_FILE}" "Fetching Live Radio data from Sikhnet.com"
    result=$?

    if [ $result -ne 0 ]; then
        echo -e "${RED}Failed to fetch data.${NC} ${BRIGHT_BLACK}Log: ${SPINNER_LOG_FILE}${NC}"
        exit 1
    fi

    local url=$(jq -r --arg title "$last_played" '.[] | select(.isLive == true and .isOnline == true) | select("\(.title) - \(.location)" == $title) | .resource' ${RADIO_DATA_FILE})

    if [ -z "$url" ] || [ "$url" = "null" ]; then
        echo -e "${RED}Last played channel '$last_played' is not available or offline.${NC}"
        rm -f "${RADIO_DATA_FILE}"
        exit 1
    fi

    rm -f "${RADIO_DATA_FILE}"

    # Stop any existing playback
    if is_vlc_running; then
        stop_playback
    fi

    # Start playback
    echo -e "${GREEN}Playing $last_played...${NC}"
    if launch_vlc "$url"; then
        echo -e "${GREEN}Stream playing in VLC${NC}"
        echo -e "${BRIGHT_BLACK}Stop with: $(basename $0) --stop${NC}"
    else
        echo -e "${RED}Failed to launch VLC${NC}"
        exit 1
    fi
    exit 0
}

