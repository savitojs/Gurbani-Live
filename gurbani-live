}

function install_script() {
    local script_name="gurbani-live"
    local available_dirs=()
    local target_dir=""
    local non_interactive=false

    # Check if running in non-interactive mode (e.g., piped from curl or in CI)
    if [ ! -t 0 ] || [ -n "$CI" ]; then
        non_interactive=true
    fi

    IFS=':' read -r -a path_dirs <<< "$PATH"
    path_dirs=($(echo "${path_dirs[@]}" | tr ' ' '\n' | sort -u | tr '\n' ' '))

    if [ "$non_interactive" = false ]; then
        echo -e "${CYAN}🔍 Checking for writable directories in your PATH...${NC}"
    fi

    for dir in "${path_dirs[@]}"; do
        if [ -d "$dir" ] && [ -w "$dir" ]; then
            available_dirs+=("$dir")
        fi
    done

    if [ ${#available_dirs[@]} -eq 0 ]; then
        echo -e "${RED}No writable directories found in your PATH.${NC}"
        exit 1
    fi

    if [ "$non_interactive" = true ]; then
        # Non-interactive mode: choose default directory
        # Prefer ~/.local/bin, then ~/bin, then first available
        for preferred in "$HOME/.local/bin" "$HOME/bin"; do
            for dir in "${available_dirs[@]}"; do
                if [ "$dir" = "$preferred" ]; then
                    target_dir="$dir"
                    break 2
                fi
            done
        done

        # If no preferred directory found, use first available
        if [ -z "$target_dir" ]; then
            target_dir="${available_dirs[0]}"
        fi

        echo -e "${CYAN}🎵 Installing Gurbani Live to: ${GREEN}$target_dir${NC}"
    else
        # Interactive mode: let user choose
        echo -e "${YELLOW}📂 The following directories in your PATH are writable:${NC}"
        echo ""
        select target_dir in "${available_dirs[@]}"; do
            if [ -n "$target_dir" ]; then
                break
            else
                echo -e "${RED}Invalid selection.${NC}"
            fi
        done
    fi

    if [ "$non_interactive" = false ]; then
        echo -e "${YELLOW}📥 Installing the script to $target_dir...${NC}"
    fi
    curl -sfL --connect-timeout 5 --max-time 30 "$SCRIPT_URL" -o "$target_dir/$script_name" && chmod +x "$target_dir/$script_name"

    if [ $? -eq 0 ]; then
        echo -e "${GREEN}🙏 Gurbani Live installed successfully! ${YELLOW}($target_dir)${NC}"
        echo ""

        if [ "$non_interactive" = false ]; then
            clean_old_script "true"
        fi

        echo -e "${CYAN}🎶 You can now run: ${GREEN}$script_name${NC}"
        echo -e "${PURPLE}🙏 May the divine Gurbani bring peace to your soul${NC}"
        exit 0
    else
        echo -e "${RED}Failed to install the script. Please try again.${NC}"
        exit 1
    fi
}

function update_script() {
    execute_and_wait "curl -sf --connect-timeout 5 --max-time 10 'https://api.github.com/repos/savitojs/Gurbani-Live/releases/latest' -o ${GURBANI_TMP}.version.json" "Checking for updates"
    UPSTREAM_VERSION=$(grep '"tag_name"' "${GURBANI_TMP}.version.json" 2>/dev/null | sed -E 's/.*"tag_name": *"([^"]+)".*/\1/')

    if [ -z "$UPSTREAM_VERSION" ]; then
        echo -e "${RED}Could not reach GitHub.${NC}"
        exit 1
    fi

    clean_old_script "true"

    if [ "$UPSTREAM_VERSION" == "$VERSION" ]; then
        echo -e "${GREEN}Already on latest (${VERSION})${NC}"
        exit 0
    fi

    echo ""
    echo -e "  ${YELLOW}${VERSION}${NC} ${BRIGHT_BLACK}->${NC} ${GREEN}${UPSTREAM_VERSION}${NC}"
    echo ""

    if [ ! -w "$0" ]; then
        echo -e "${RED}Cannot write to $(dirname "$0"). Try with sudo.${NC}"
        exit 1
    fi

    read -p "Update now? [Y/n] " confirm
    if [[ "$confirm" =~ ^[Nn]$ ]]; then
        echo -e "${BRIGHT_BLACK}Cancelled.${NC}"
        exit 0
    fi

    LATEST_SCRIPT_URL="https://github.com/savitojs/Gurbani-Live/releases/latest/download/gurbani-live"

    local tmp_script
    tmp_script=$(mktemp "${GURBANI_TMP}.update.XXXXXX")

    if ! curl -o "$tmp_script" -sfL --connect-timeout 5 --max-time 30 "$LATEST_SCRIPT_URL"; then
        rm -f "$tmp_script"
        echo -e "${RED}Download failed.${NC}"
        exit 1
    fi

    if [ ! -s "$tmp_script" ] || ! head -1 "$tmp_script" | grep -q '^#!/bin/bash'; then
        rm -f "$tmp_script"
        echo -e "${RED}Invalid download. Your script is unchanged.${NC}"
        exit 1
    fi

    chmod +x "$tmp_script"
    mv "$tmp_script" "$0"
    echo -e "${GREEN}Updated to ${UPSTREAM_VERSION}${NC}"
    exit 0
}

function is_vlc_running() {
    if [ -f "$VLC_PID_FILE" ]; then
        local saved_pid
        saved_pid=$(cat "$VLC_PID_FILE")
        if [ -n "$saved_pid" ] && kill -0 "$saved_pid" 2>/dev/null; then
            return 0
        fi
        rm -f "$VLC_PID_FILE"
    fi
    return 1
}

function stop_playback() {
    echo -e "${RED}Stopping playback...${NC}"
    if [ -n "$CURRENT_PLAYING_CHANNEL" ]; then
        echo -e "${BRIGHT_BLACK}Was playing: $CURRENT_PLAYING_CHANNEL${NC}"
    fi

    if [ -f "$VLC_PID_FILE" ]; then
        local saved_pid
        saved_pid=$(cat "$VLC_PID_FILE")
        if [ -n "$saved_pid" ]; then
            kill "$saved_pid" 2>/dev/null
            wait "$saved_pid" 2>/dev/null
        fi
        rm -f "$VLC_PID_FILE"
    else
        # Fallback: no PID file, kill by name (e.g., started outside this script)
        if [[ "$OS" == "Darwin" ]]; then
            pkill -f "VLC" > /dev/null 2>&1 || killall VLC > /dev/null 2>&1
        else
            pkill vlc > /dev/null 2>&1 || pkill VLC > /dev/null 2>&1
        fi
    fi
    echo -e "${GREEN}Playback stopped.${NC}"
    echo ""

    CURRENT_PLAYING_CHANNEL=""
    CURRENT_PLAYING_URL=""
}

function check_dependencies() {
    local missing=()

    # Check for VLC
    if [[ "$OS" == "Darwin" ]]; then
        # On macOS, check for VLC.app or vlc command
        if ! command -v vlc &>/dev/null && [ ! -d "/Applications/VLC.app" ]; then
            missing+=("vlc")
        fi
    else
        # On Linux, check for vlc command
        if ! command -v vlc &>/dev/null; then
            missing+=("vlc")
        fi
    fi

    # Check other deps
    for cmd in fzf jq; do
        if ! command -v $cmd &>/dev/null; then
            missing+=($cmd)
        fi
    done

    if [ ${#missing[@]} -gt 0 ]; then
        echo -e "${RED}Missing dependencies: ${missing[@]}${NC}"
        echo -e "${YELLOW}Attempting to install missing dependencies...${NC}"

        if [[ "$OSTYPE" == "darwin"* ]]; then
            if command -v brew &>/dev/null; then
                for cmd in "${missing[@]}"; do
                    brew install $cmd
                done
            else
                echo "Homebrew is not installed. Please install it from https://brew.sh/"
                exit 1
            fi
        elif [[ -f /etc/fedora-release ]]; then
            sudo dnf install -y "${missing[@]}"
        elif [[ -f /etc/lsb-release ]]; then
            sudo apt-get install -y "${missing[@]}"
        else
            echo "Unsupported OS. Please install the following dependencies manually: ${missing[@]}"
            exit 1
        fi
    fi
}

#
# https://gitlab.com/-/snippets/1936196
#
function execute_and_wait() {
  bash -c "$1" >${SPINNER_LOG_FILE} 2>&1 &
  pid=$!
  delay=0.05

  frames=('\u280B' '\u2819' '\u2839' '\u2838' '\u283C' '\u2834' '\u2826' '\u2827' '\u2807' '\u280F')

  echo "$pid" >"${GURBANI_TMP}.spinner.pid"

  # Hide cursor (only if we have a proper terminal)
  if [ -t 1 ] && [ -n "$TERM" ] && [ "$TERM" != "dumb" ]; then
    tput civis 2>/dev/null || true
  fi
  index=0
  framesCount=${#frames[@]}
  while kill -0 $pid 2>/dev/null; do
    printf "\r${YELLOW}${frames[$index]}${NC} ${GREEN}$2${NC}\033[K"

    let index=index+1
    if [ "$index" -ge "$framesCount" ]; then
      index=0
    fi

    sleep $delay
  done

  wait $pid
  exitCode=$?

  if [ "$exitCode" -eq "0" ]; then
    printf "\r${CHECK_SYMBOL} ${2}\033[K\n"
  else
    printf "\r${X_SYMBOL} ${2}\033[K\n"
  fi

  # show cursor (only if we have a proper terminal)
  if [ -t 1 ] && [ -n "$TERM" ] && [ "$TERM" != "dumb" ]; then
    tput cnorm 2>/dev/null || true
  fi

  return $exitCode
}

function show_status() {
    execute_and_wait "curl -sf --connect-timeout 5 --max-time 15 https://play.sikhnet.com/api/radio -o ${RADIO_DATA_FILE}" "Fetching Live Radio data from Sikhnet.com"
    result=$?

    if [ $result -ne 0 ]; then
      echo -e "${RED}Failed to fetch data.${NC} ${BRIGHT_BLACK}Log: ${SPINNER_LOG_FILE}${NC}"
      exit 1
    fi

    local fmt="  %-30s %-10s %-10s %s\n"
    echo ""
    printf "${BLUE}${fmt}${NC}" "Title" "Channel" "Status" "Location"
    local cols
    cols=$(tput cols 2>/dev/null || echo 70)
    local rule
    rule=$(printf '─%.0s' $(seq 1 $((cols - 4))))
    echo -e "  ${BRIGHT_BLACK}${rule}${NC}"

    jq -r '.[] | select(.isLive == true) | "\(.title)\t\(.channel)\t\(.isOnline)\t\(.location)"' ${RADIO_DATA_FILE} | while IFS=$'\t' read -r title channel isOnline location; do
        if [ "$isOnline" = "true" ]; then
            online_status="${GREEN}Online${NC}"
        else
            online_status="${RED}Offline${NC}"
        fi
        printf "  %-30s %-10s " "$title" "$channel"
        printf "${online_status}"
        # Pad to 10 visible chars (Online=6, Offline=7)
        if [ "$isOnline" = "true" ]; then
            printf "     "
        else
            printf "    "
        fi
        printf "%s\n" "$location"
    done

    rm -f "${RADIO_DATA_FILE}"
    exit 0
}

function load_favorites() {
    if [ -f "$FAVORITES_FILE" ]; then
        cat "$FAVORITES_FILE"
    fi
}

function save_favorite() {
    local channel="$1"
    if [ ! -f "$FAVORITES_FILE" ]; then
        touch "$FAVORITES_FILE"
    fi
    if ! grep -qxF "$channel" "$FAVORITES_FILE"; then
        echo "$channel" >> "$FAVORITES_FILE"
        echo -e "${GREEN}✅ Added to favorites: $channel${NC}"
    else
        echo -e "${YELLOW}Already in favorites: $channel${NC}"
    fi
}

function remove_favorite() {
    local channel="$1"
    if [ -f "$FAVORITES_FILE" ]; then
        grep -vxF "$channel" "$FAVORITES_FILE" > "${FAVORITES_FILE}.tmp" || true
        mv "${FAVORITES_FILE}.tmp" "$FAVORITES_FILE"
        echo -e "${GREEN}Removed from favorites: $channel${NC}"
    fi
}

function is_favorite() {
    local channel="$1"
    if [ -f "$FAVORITES_FILE" ] && grep -qxF "$channel" "$FAVORITES_FILE"; then
        return 0
    else
        return 1
    fi
}

function save_last_played() {
    local channel="$1"
    # Only save the first line (in case of accidental multiline input; play safe)
    echo "$channel" | head -n 1 > "$LAST_PLAYED_FILE"
}

function load_last_played() {
    if [ -f "$LAST_PLAYED_FILE" ]; then
        head -n 1 "$LAST_PLAYED_FILE"
    fi
}

