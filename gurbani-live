}

function get_channel_count() {
    local count=$(jq -r '[.[] | select(.isLive == true and .isOnline == true)] | length' ${RADIO_DATA_FILE} 2>/dev/null || echo "0")
    echo "$count"
}

function main_menu() {
    select_and_play_channel
}

function select_and_play_channel() {
    local temp_file="${CHANNEL_SELECT_FILE}"

    # Clear the temp file
    > "$temp_file"

    # Add refresh option first
    echo "🔄 Refresh Channel List" >> "$temp_file"

    # Process channels and add to temp file with proper formatting
    while IFS=$'\t' read -r title channel isOnline location url; do
        if [ "$isOnline" = "true" ]; then
            local channel_name="$title - $location"
            if is_favorite "$channel_name"; then
                echo "⭐ $channel_name" >> "$temp_file"
            else
                echo "$channel_name" >> "$temp_file"
            fi
        fi
    done < <(jq -r '.[] | select(.isLive == true) | "\(.title)\t\(.channel)\t\(.isOnline)\t\(.location)\t\(.resource)"' ${RADIO_DATA_FILE})

    local channel_count
    channel_count=$(get_channel_count)
    local last_played
    last_played=$(load_last_played)

    local fzf_header="${channel_count} channels online"
    if [ -n "$CURRENT_PLAYING_CHANNEL" ]; then
        fzf_header="${fzf_header}  ♫ ${CURRENT_PLAYING_CHANNEL}"
    fi
    if [ -n "$last_played" ] && [ "$last_played" != "🔄 Refresh Channel List" ]; then
        fzf_header="${fzf_header}
Last played: ${last_played}"
    fi

    selected_name=$(cat "$temp_file" | fzf \
        --no-sort \
        --height=~20 \
        --border=rounded \
        --layout=reverse \
        --pointer='▶' \
        --prompt='♫ Select channel: ' \
        --header="$fzf_header" \
        --color='pointer:green,prompt:cyan,header:blue,border:bright-black,hl:yellow,hl+:yellow' \
        --info=inline \
    )

    if [ -z "$selected_name" ]; then
        echo "No selection made, exiting."
        rm "$temp_file"
        exit 0
    fi

    # Handle refresh option
    if [ "$selected_name" = "🔄 Refresh Channel List" ]; then
        rm "$temp_file"
        if refresh_channel_list; then
            main_menu
        else
            echo -e "${RED}Failed to refresh. Please try again.${NC}"
            exit 1
        fi
        return
    fi

    # Remove star from display name to get original channel name
    local original_channel_name="${selected_name#⭐ }"

    # Find the URL for the selected channel
    local url=""
    while IFS=$'\t' read -r title channel isOnline location u; do
        if [ "$isOnline" = "true" ]; then
            local cname="$title - $location"
            if [ "$cname" = "$original_channel_name" ]; then
                url="$u"
                break
            fi
        fi
    done < <(jq -r '.[] | select(.isLive == true) | "\(.title)\t\(.channel)\t\(.isOnline)\t\(.location)\t\(.resource)"' ${RADIO_DATA_FILE})

    rm "$temp_file"
    rm -f "${RADIO_DATA_FILE}"

    # Save as last played (only if it's a real channel, not refresh option)
    if [ "$original_channel_name" != "🔄 Refresh Channel List" ]; then
        save_last_played "$original_channel_name"
    fi

    handle_playback "$original_channel_name" "$url"
}

function draw_visualizer() {
    VIZ_OUTPUT=""
    case "$VIZ_STYLE" in
        bars)
            for _ in {1..8}; do
                VIZ_OUTPUT+="${VIZ_BARS[$((RANDOM % ${#VIZ_BARS[@]}))]}"
            done
            ;;
        music)
            VIZ_OUTPUT="${VIZ_MUSIC[$VIZ_INDEX]}"
            VIZ_INDEX=$(( (VIZ_INDEX + 1) % ${#VIZ_MUSIC[@]} ))
            ;;
        wave)
            VIZ_OUTPUT="${VIZ_WAVE[$VIZ_INDEX]}"
            VIZ_INDEX=$(( (VIZ_INDEX + 1) % ${#VIZ_WAVE[@]} ))
            ;;
        pulse)
            VIZ_OUTPUT="${VIZ_PULSE[$VIZ_INDEX]}"
            VIZ_INDEX=$(( (VIZ_INDEX + 1) % ${#VIZ_PULSE[@]} ))
            ;;
        braille)
            VIZ_OUTPUT="${VIZ_BRAILLE[$VIZ_INDEX]}"
            VIZ_INDEX=$(( (VIZ_INDEX + 1) % ${#VIZ_BRAILLE[@]} ))
            ;;
    esac
}

function handle_playback() {
    local selected_index="$1"
    local url="$2"

    # Set current playing channel
    CURRENT_PLAYING_CHANNEL="$selected_index"
    CURRENT_PLAYING_URL="$url"

    if is_vlc_running; then
        echo -e "${RED}Stopping previous playback...${NC}"
        stop_playback
    fi

    if launch_vlc "$url"; then
        local fav_label
        if is_favorite "$selected_index"; then
            fav_label="un[f]av"
        else
            fav_label="[f]av"
        fi
        local cols
        cols=$(tput cols 2>/dev/null || echo 50)
        local rule
        rule=$(printf '─%.0s' $(seq 1 "$cols"))
        local viz_max_name=$((cols - 20))
        local viz_display_name="${selected_index:0:$viz_max_name}"
        echo ""
        echo -e "${BRIGHT_BLACK}${rule}${NC}"
        echo -e "  ${CYAN}Now playing: ${GREEN}${viz_display_name}${NC}"
        echo -e "  🛑 ${RED}[s]${NC}top  💤 ${BLUE}[b]${NC}ackground  🔄 ${CYAN}[c]${NC}hange  ⭐ ${YELLOW}${fav_label}${NC}  📻 ${GREEN}[r]${NC}efresh"
        echo -e "${BRIGHT_BLACK}${rule}${NC}"
    else
        echo -e "${RED}Failed to launch VLC${NC}"
        exit 1
    fi

    local viz_timeout=0.15
    if (( BASH_VERSINFO[0] < 4 )); then
        viz_timeout=1
    fi

    while true; do
        if ! is_vlc_running; then
            printf "\033[3A\r\033[K"
            echo -e "  ${BRIGHT_BLACK}Playback ended.${NC}"
            printf "\033[2B"
            exit 0
        fi

        draw_visualizer
        printf "\033[3A\r  ${BLUE}${VIZ_OUTPUT}${NC} ${CYAN}Now playing: ${GREEN}${viz_display_name}${NC}\033[K\033[3B\r"

        read -t "$viz_timeout" -n 1 -s choice || choice=""

        case "$choice" in
            "s"|"S")
                echo ""
                stop_playback && exit 0
                ;;
            "b"|"B")
                echo ""
                echo -e "${GREEN}Running in background.${NC}"
                echo -e "${BRIGHT_BLACK}Stop with: $(basename $0) --stop${NC}"
                exit
                ;;
            "c"|"C")
                echo ""
                execute_and_wait "curl -sf --connect-timeout 5 --max-time 15 https://play.sikhnet.com/api/radio -o ${RADIO_DATA_FILE}" "Fetching Live Radio data from Sikhnet.com"
                result=$?
                if [ $result -ne 0 ]; then
                    echo -e "${RED}Failed to fetch data.${NC} ${BRIGHT_BLACK}Log: ${SPINNER_LOG_FILE}${NC}"
                    exit 1
                fi
                select_and_play_channel
                ;;
            "f"|"F")
                if is_favorite "$selected_index"; then
                    remove_favorite "$selected_index" > /dev/null
                    printf "\033[3A\r  ${YELLOW}Removed from favorites${NC}\033[K\033[3B\r"
                else
                    save_favorite "$selected_index" > /dev/null
                    printf "\033[3A\r  ${GREEN}Added to favorites${NC}\033[K\033[3B\r"
                fi
                sleep 1
                ;;
            "r"|"R")
                echo ""
                if refresh_channel_list; then
                    select_and_play_channel
                else
                    echo -e "${RED}Failed to refresh channels.${NC}"
                fi
                ;;
            *)
                ;;
        esac
    done
}

function launch_vlc() {
    local url="$1"
    local background="${2:-true}"

    if [[ "$OS" == "Darwin" ]]; then
        if [ -d "/Applications/VLC.app" ]; then
            if [ "$background" = "true" ]; then
                open -a VLC "$url" > /dev/null 2>&1 &
                echo $! > "$VLC_PID_FILE"
            else
                open -a VLC "$url"
            fi
        elif command -v vlc &>/dev/null; then
            local VLC_BIN=$(which vlc)
            if [ "$background" = "true" ]; then
                $VLC_BIN -I dummy "$url" > /dev/null 2>&1 &
                echo $! > "$VLC_PID_FILE"
            else
                $VLC_BIN "$url"
            fi
        else
            echo -e "${RED}VLC not found. Please install VLC from the Mac App Store or with 'brew install vlc'${NC}"
            return 1
        fi
    else
        local VLC_BIN=$(which vlc)
        if [ "$background" = "true" ]; then
            $VLC_BIN -I dummy "$url" > /dev/null 2>&1 &
            echo $! > "$VLC_PID_FILE"
        else
            $VLC_BIN "$url"
        fi
    fi
}

